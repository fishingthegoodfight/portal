# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Email transport: "resend" (default) or "smtp".
EMAIL_PROVIDER=resend

# SMTP (used when EMAIL_PROVIDER=smtp). Port 465 uses implicit TLS; other
# ports (e.g. 587) use STARTTLS. EMAIL_FROM is the From address for SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM="Fishing the Good Fight <notifications@fishingthegoodfight.org>"

# Resend (RSVP confirmation/cancellation emails) — https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
# Defaults to a resend.dev test sender (works before the org's domain is
# verified with Resend); override once fishingthegoodfight.org is verified.
RESEND_FROM="Fishing the Good Fight <onboarding@resend.dev>"

# Absolute origin used to build links in emails (event page, calendar invite
# links). Set this once the org has a real domain; until then links fall
# back to the Vercel deployment URL, then to localhost in dev.
NEXT_PUBLIC_SITE_URL=https://fishingthegoodfight.org

# Service role key (Project Settings > API Keys > service_role) — used ONLY
# server-side by the admin "Add walk-up" flow to create an auth user for a
# walk-up with no existing account. Never prefix this with NEXT_PUBLIC_ and
# never import lib/supabase/admin.ts from client code — it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of addresses that get an internal notification email
# on every event create/edit/cancel — who changed what, before/after, and
# the reason for a cancellation. Fires on every change, including ones made
# by someone on this list. Leave unset to disable (no error, just a no-op).
ADMIN_NOTIFICATION_EMAILS=admin1@fishingthegoodfight.org,admin2@fishingthegoodfight.org

# Shared secret for /api/cron/reminders. Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" once set in the project's env vars;
# without it the route rejects every request. Generate e.g. `openssl rand -hex 32`.
CRON_SECRET=generate-a-long-random-string
